{
  "name": "hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": "src/hub.ts",
  "description": "Personal hub — CRM-Like system built for human agents, that's capable of managing contacts, to-do's and interactions.",
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "start": "node src/hub.ts",
    "typecheck": "tsc --noEmit",
    "fmt": "prettier --write src tests",
    "fmt:check": "prettier --check src tests",
    "edit": "srt --settings '.srt-settings-personal-hub.json' opencode --standalone"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.82",
    "@types/node": "^24",
    "drizzle-kit": "^0.31.11",
    "omelette": "^0.4.17",
    "prettier": "^3.6.0",
    "typescript": "^6.0.2"
  }
}
